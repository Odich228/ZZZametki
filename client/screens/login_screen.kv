#:kivy 2.3.0

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(30)
        spacing: dp(12)

        Label:
            text: 'Вход в Notes App'
            font_size: '22sp'
            size_hint_y: None
            height: dp(50)

        TextInput:
            id: email_input
            hint_text: 'Email'
            multiline: False
            size_hint_y: None
            height: dp(44)

        TextInput:
            id: password_input
            hint_text: 'Пароль'
            password: True
            multiline: False
            size_hint_y: None
            height: dp(44)

        Label:
            text: root.error_text
            color: 1, 0.2, 0.2, 1
            size_hint_y: None
            height: dp(24)

        Button:
            text: 'Войти'
            size_hint_y: None
            height: dp(48)
            on_press: root.do_login()

        Button:
            text: 'Регистрация'
            size_hint_y: None
            height: dp(40)
            on_press: root.go_to_register()

        Widget:
            # растягивается, прижимает всё выше к верху экрана
